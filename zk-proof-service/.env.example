# ZK Proof Service Configuration
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# Service API Keys & Security (Placeholders)
# Required in production: service refuses to start without this token.
ZK_PROOF_API_TOKEN=your_sanitized_api_token_placeholder_here

# Secret Store Integration (AWS Secrets Manager or HashiCorp Vault)
# SECRET_STORE_PROVIDER=aws # or 'vault'
# AWS_SECRETS_MANAGER_SECRET_ID=sorotask/zk-proof-service/production
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_SECRET_PATH=secret/data/sorotask/zk-proof-service
