{
  "name": "keeper",
  "version": "1.0.0",
  "description": "SoroTask Keeper - Production-grade task execution service for Soroban smart contracts",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js | pino-pretty",
    "dry-run": "node index.js --dry-run",
    "mock-rpc": "node mock-rpc.js",
    "test": "jest",
    "test:e2e": "node __tests__/e2e-run.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage": "jest --coverage",
    "test:chaos": "jest chaos.test.js",
    "lint": "eslint src/ __tests__/",
    "lint:fix": "eslint src/ __tests__/ --fix",
    "docker:build": "docker build -t sorotask-keeper .",
    "docker:run": "docker run --env-file .env -p 3000:3000 -v $(pwd)/data:/app/data sorotask-keeper",
    "bench": "node benchmarks/poller.bench.js && node benchmarks/executor.bench.js",
    "bench:poller": "node benchmarks/poller.bench.js",
    "bench:executor": "node benchmarks/executor.bench.js",
    "bench:compare": "node benchmarks/compare.js",
    "chaos-test": "node scripts/chaos-test.js run",
    "chaos-test:list": "node scripts/chaos-test.js list",
    "chaos-test:single": "node scripts/chaos-test.js single",
    "helm:lint": "node scripts/validate-helm-keda.js",
    "k8s:validate": "node scripts/validate-helm-keda.js"
  },
  "keywords": [
    "soroban",
    "stellar",
    "keeper",
    "automation",
    "smart-contracts"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1152.0",
    "@google-cloud/kms": "^6.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sorotask": "file:.."
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "babel-jest": "^30.5.2",
    "benny": "^3.7.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0"
  }
}
