# Dependencies — re-installed inside the container from package-lock.json
node_modules

# Secrets — must never be baked into an image
.env
.env.*
*.secret

# Persisted runtime state — mounted as a volume at runtime
data/

# Version control metadata
.git
.gitignore

# Test artefacts & coverage reports
coverage
__tests__
*.test.js
index.test.js
test-cjs.js
test-esm.js

# Documentation
*.md
docs/
ARCHITECTURE.md
DOCKER.md
README.md

# Development files
.eslintrc.json
eslint.config.js
eslint.config.mjs
babel.config.js
jest.config.js
.prettierrc

# Benchmarks
benchmark/
benchmarks/

# IDE/OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.tgz
.cache/
.scratch/
examples/
scripts/
*.sh